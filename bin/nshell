#!/usr/bin/env bash
# The command of the shell. NSHELL_PATH is the folder of the shell, set by the package, or by hand to run one from a checkout
#
#   nshell                  starts the shell
#   nshell center [dnd]     opens and closes the history of the notifications, or toggles do not disturb
#   nshell bar [audio|battery|tray]  shows and hides the bar, or opens one of its popups
#   nshell launcher [windows]  opens the launcher, on the apps or on the windows
#   nshell pick [--prompt TEXT]  a choice for a script: it reads the lines on stdin, a line is "title", "title<TAB>subtitle" or
#                           "title<TAB>subtitle<TAB>icon", shows them in the style of the shell, and prints the line that was
#                           chosen. The exit status is 0 for a choice and 1 when it was cancelled, 2 when the shell is not running
set -eu
: "${NSHELL_PATH:?NSHELL_PATH is not set}"

case "${1:-}" in
"") exec quickshell -p "$NSHELL_PATH" ;;
center) exec quickshell -p "$NSHELL_PATH" ipc call center "${2:-toggle}" ;;
bar) exec quickshell -p "$NSHELL_PATH" ipc call bar "${2:-toggle}" ;;
launcher) exec quickshell -p "$NSHELL_PATH" ipc call launcher "${2:-apps}" ;;
pick)
	shift
	prompt=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--prompt | -p)
			prompt="${2:-}"
			shift 2
			;;
		*)
			echo "usage: nshell pick [--prompt TEXT]" >&2
			exit 1
			;;
		esac
	done
	dir="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/nshell-pick.XXXXXX")"
	trap 'rm -rf "$dir"' EXIT
	# the lines, and the pipe that the shell answers on: reading it waits until it does
	mkfifo "$dir/result"
	cat >"$dir/items"
	quickshell -p "$NSHELL_PATH" ipc call launcher pick "$dir" "$prompt" >/dev/null || exit 2
	answer="$(cat "$dir/result")"
	if [ "${answer%%$'\n'*}" = "OK" ]; then
		printf '%s\n' "${answer#*$'\n'}"
		exit 0
	fi
	exit 1
	;;
*)
	echo "usage: nshell [center [dnd] | bar | launcher [windows] | pick [--prompt TEXT]]" >&2
	exit 1
	;;
esac
