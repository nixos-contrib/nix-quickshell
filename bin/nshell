#!/usr/bin/env bash
# The command of the shell. NSHELL_PATH is the folder of the shell, set by the package, or by hand to run one from a checkout
#
#   nshell                  starts the shell
#   nshell center [dnd]     opens and closes the history of the notifications, or toggles do not disturb
#   nshell bar [audio|battery|tray]  shows and hides the bar, or opens one of its popups
#   nshell launcher [windows]  opens the launcher, on the apps or on the windows
#   nshell launch ID        an app by the id of its desktop entry (brave-browser): its window is focused when it has one, and it is
#                           started when it has none
#   nshell theme [dark|light|auto|toggle]  the mode of the theme, auto follows the hours of the day. Without an argument, says it
#   nshell apps [dark|light]  puts the files of a mode where the apps read them, and tells the GTK apps, xterm and i3 to read them again.
#                           The shell runs it when the mode changes, and the session at its start. Without a mode it takes the saved one
#   nshell pick [--prompt TEXT]  a choice for a script: it reads the lines on stdin, a line is "title", "title<TAB>subtitle" or
#                           "title<TAB>subtitle<TAB>icon", shows them in the style of the shell, and prints the line that was
#                           chosen. The exit status is 0 for a choice and 1 when it was cancelled, 2 when the shell is not running
set -eu
: "${NSHELL_PATH:?NSHELL_PATH is not set}"

# A key that is held a moment repeats, 40 times a second, and runs the command each time. These commands toggle, so the repeat would
# close what the first opened. Starting the client of Quickshell takes long enough for the runs to pile up and reach the shell in
# bursts, so the repeat is caught here: a run less than 400 ms after the one before is the same press, and ends at once. Every run
# counts as the one before, so a key held for any time is one press
same_press() {
	local stamp="${XDG_RUNTIME_DIR:-/tmp}/nshell-key-press" now last
	now="$(date +%s%3N)"
	last="$(cat "$stamp" 2>/dev/null || echo 0)"
	printf '%s' "$now" >"$stamp"
	[ $((now - last)) -lt 400 ]
}

case "${1:-}" in
center | bar | launcher | launch | theme) same_press && exit 0 ;;
esac

# The apps follow the mode: nix-shell (the Nix module) writes the files of both modes in ~/.config/nix-shell, and this copies the ones
# of a mode into the state folder, which the configs of the apps include, and asks the apps to read them again: xsettingsd (the GTK
# apps change themselves, live), xrdb (xterm, at its next start) and i3 (the colors of the tabs)
apply_apps() {
	local mode="${1:-}" cfg="${XDG_CONFIG_HOME:-$HOME/.config}/nix-shell" state="${XDG_STATE_HOME:-$HOME/.local/state}/nix-shell" changed=0
	if [ -z "$mode" ]; then
		mode="$(grep -o '"mode" *: *"[a-z]*"' "$state/theme.json" 2>/dev/null | head -n1 | grep -o '"[a-z]*"$' | tr -d '"' || true)"
	fi
	# auto, or nothing saved: the start is dark, and the shell says the mode of the hour as soon as it runs
	[ "$mode" = light ] || mode=dark
	mkdir -p "$state"
	copy() {
		[ -f "$cfg/$1-$mode$2" ] || return 0
		if ! cmp -s "$cfg/$1-$mode$2" "$state/$3"; then
			install -m644 "$cfg/$1-$mode$2" "$state/$3"
			return 0
		fi
		return 1
	}
	copy xsettings .conf xsettings.conf && pkill -HUP -x xsettingsd 2>/dev/null || true
	copy zathurarc "" zathurarc || true
	if copy i3 .conf i3.conf; then changed=1; fi
	[ -f "$cfg/xresources-$mode" ] && xrdb -merge "$cfg/xresources-$mode" 2>/dev/null || true
	# the tabs of i3 are drawn again with the colors of the mode
	if [ "$changed" = 1 ]; then i3-msg reload >/dev/null 2>&1 || true; fi
}

case "${1:-}" in
"") exec quickshell -p "$NSHELL_PATH" ;;
apps) apply_apps "${2:-}" ;;
center) exec quickshell -p "$NSHELL_PATH" ipc call center "${2:-toggle}" ;;
bar) exec quickshell -p "$NSHELL_PATH" ipc call bar "${2:-toggle}" ;;
launcher) exec quickshell -p "$NSHELL_PATH" ipc call launcher "${2:-apps}" ;;
theme)
	case "${2:-}" in
	"") exec quickshell -p "$NSHELL_PATH" ipc call theme get ;;
	toggle) exec quickshell -p "$NSHELL_PATH" ipc call theme toggle ;;
	*) exec quickshell -p "$NSHELL_PATH" ipc call theme set "$2" ;;
	esac
	;;
launch) exec quickshell -p "$NSHELL_PATH" ipc call launcher launch "${2:?usage: nshell launch ID}" ;;
pick)
	shift
	prompt=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--prompt | -p)
			prompt="${2:-}"
			shift 2
			;;
		*)
			echo "usage: nshell pick [--prompt TEXT]" >&2
			exit 1
			;;
		esac
	done
	dir="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/nshell-pick.XXXXXX")"
	trap 'rm -rf "$dir"' EXIT
	# the lines, and the pipe that the shell answers on: reading it waits until it does
	mkfifo "$dir/result"
	cat >"$dir/items"
	quickshell -p "$NSHELL_PATH" ipc call launcher pick "$dir" "$prompt" >/dev/null || exit 2
	answer="$(cat "$dir/result")"
	if [ "${answer%%$'\n'*}" = "OK" ]; then
		printf '%s\n' "${answer#*$'\n'}"
		exit 0
	fi
	exit 1
	;;
*)
	echo "usage: nshell [center [dnd] | bar | launcher [windows] | launch ID | theme [dark|light|auto|toggle] | apps [dark|light] | pick [--prompt TEXT]]" >&2
	exit 1
	;;
esac
