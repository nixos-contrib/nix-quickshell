#!/usr/bin/env bash
# The command of the shell. NSHELL_PATH is the folder of the shell, set by the package, or by hand to run one from a checkout
#
#   nshell                  starts the shell
#   nshell center [dnd]     opens and closes the history of the notifications, or toggles do not disturb
#   nshell bar [audio|battery|calendar|media|tray]  shows and hides the bar, or opens one of its popups
#   nshell calendar         opens and closes the calendar under the clock
#   nshell launcher [windows]  opens the launcher, on the apps or on the windows
#   nshell launch ID        an app by the id of its desktop entry (brave-browser): its window is focused when it has one, and it is
#                           started when it has none
#   nshell tabs list        opens the list of the windows of the tabbed container that has the focus, under its chevron in the bar
#   nshell theme [dark|light|auto|toggle]  the mode of the theme, auto follows the hours of the day. Without an argument, says it
#   nshell apps [dark|light]  puts the files of a mode where the apps read them, and tells the GTK apps and the apps of apps/ to read them again.
#                           The shell runs it when the mode changes, and the session at its start. Without a mode it takes the saved one
#   nshell pick [--prompt TEXT]  a choice for a script: it reads the lines on stdin, a line is "title", "title<TAB>subtitle" or
#                           "title<TAB>subtitle<TAB>icon", shows them in the style of the shell, and prints the line that was
#                           chosen. The exit status is 0 for a choice and 1 when it was cancelled, 2 when the shell is not running
set -eu
: "${NSHELL_PATH:?NSHELL_PATH is not set}"

# A key that is held a moment repeats, 40 times a second, and runs the command each time. These commands toggle, so the repeat would
# close what the first opened. Starting the client of Quickshell takes long enough for the runs to pile up and reach the shell in
# bursts, so the repeat is caught here: a run less than 400 ms after the one before is the same press, and ends at once. Every run
# counts as the one before, so a key held for any time is one press
same_press() {
	local stamp="${XDG_RUNTIME_DIR:-/tmp}/nshell-key-press" now last
	now="$(date +%s%3N)"
	last="$(cat "$stamp" 2>/dev/null || echo 0)"
	printf '%s' "$now" >"$stamp"
	[ $((now - last)) -lt 400 ]
}

case "${1:-}" in
center | bar | calendar | launcher | launch | theme) same_press && exit 0 ;;
esac

# The apps follow the mode: nix-quickshell (the Nix module) writes the files of both modes in ~/.config/nix-quickshell, and this copies the ones
# of a mode into the state folder, which the configs of the apps include, and asks the apps to read them again: xsettingsd (the GTK
# apps change themselves, live), and each app of apps/ with its own reload
# The location bar of an open Thunar keeps the small icon of the other mode until it goes to another folder: GTK does not draw it again, and
# the only way to make it do so is to swap the bar for the path buttons and back, which flashes. The rest of Thunar follows the mode live
apply_apps() {
	local mode="${1:-}" cfg="${XDG_CONFIG_HOME:-$HOME/.config}/nix-quickshell" state="${XDG_STATE_HOME:-$HOME/.local/state}/nix-quickshell"
	if [ -z "$mode" ]; then
		mode="$(grep -o '"mode" *: *"[a-z]*"' "$state/theme.json" 2>/dev/null | head -n1 | grep -o '"[a-z]*"$' | tr -d '"' || true)"
	fi
	# auto, or nothing saved: the start is dark, and the shell says the mode of the hour as soon as it runs
	[ "$mode" = light ] || mode=dark
	mkdir -p "$state"
	# xsettingsd tells the GTK apps the theme of the mode and, 0.4 s later, its twin, which looks the same: Brave reads the colors of the
	# theme when its name changes, before GTK has loaded it, so with one change it shows the mode before. The state is already this mode
	# when it is the theme or its twin
	local xs="$cfg/xsettings-$mode.conf" xt="$cfg/xsettings-$mode-twin.conf" xstate="$state/xsettings.conf"
	if [ -f "$xs" ] && ! cmp -s "$xs" "$xstate" && ! cmp -s "$xt" "$xstate"; then
		install -m644 "$xs" "$xstate"
		pkill -HUP -x xsettingsd 2>/dev/null || true
		if [ -f "$xt" ]; then
			sleep 0.4
			install -m644 "$xt" "$xstate"
			pkill -HUP -x xsettingsd 2>/dev/null || true
		fi
	fi
	# the wallpaper of the mode, when the module wrote one. The copy in the state folder outlives the session, and the root window of a new
	# X server has no image, so it is drawn each time and not only when the copy changed
	local wp="$cfg/wallpaper-$mode.png" wpstate="$state/wallpaper.png"
	if [ -f "$wp" ]; then
		cmp -s "$wp" "$wpstate" || install -m644 "$wp" "$wpstate"
		if command -v feh >/dev/null 2>&1; then feh --no-fehbg --bg-fill "$wpstate" 2>/dev/null || true; fi
	fi
	# the apps of apps/ in the module, each with the file of its mode and a file of variables that says what it is called in the state folder
	# and how it is asked to read it again. The file in the state folder outlives the session, so an app that lives in the X server (always) is
	# told at each run, as the wallpaper is, and the others when it changed
	local def name target reload always src dst
	for def in "$cfg"/apps/*.app; do
		[ -f "$def" ] || continue
		name="$(basename "$def" .app)"
		src="$cfg/apps/$name-$mode"
		[ -f "$src" ] || continue
		target="" reload="" always=0
		# shellcheck disable=SC1090
		. "$def"
		[ -n "$target" ] || continue
		dst="$state/$target"
		if ! cmp -s "$src" "$dst"; then
			install -m644 "$src" "$dst"
		elif [ "$always" != 1 ]; then
			continue
		fi
		if [ -n "$reload" ]; then NSHELL_FILE="$dst" sh -c "$reload" 2>/dev/null || true; fi
	done
}

case "${1:-}" in
"") exec quickshell -p "$NSHELL_PATH" ;;
apps) apply_apps "${2:-}" ;;
center) exec quickshell -p "$NSHELL_PATH" ipc call center "${2:-toggle}" ;;
bar) exec quickshell -p "$NSHELL_PATH" ipc call bar "${2:-toggle}" ;;
calendar) exec quickshell -p "$NSHELL_PATH" ipc call bar calendar ;;
launcher) exec quickshell -p "$NSHELL_PATH" ipc call launcher "${2:-apps}" ;;
tabs) exec quickshell -p "$NSHELL_PATH" ipc call tabs list ;;
theme)
	case "${2:-}" in
	"") exec quickshell -p "$NSHELL_PATH" ipc call theme get ;;
	toggle) exec quickshell -p "$NSHELL_PATH" ipc call theme toggle ;;
	*) exec quickshell -p "$NSHELL_PATH" ipc call theme set "$2" ;;
	esac
	;;
launch) exec quickshell -p "$NSHELL_PATH" ipc call launcher launch "${2:?usage: nshell launch ID}" ;;
pick)
	shift
	prompt=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--prompt | -p)
			prompt="${2:-}"
			shift 2
			;;
		*)
			echo "usage: nshell pick [--prompt TEXT]" >&2
			exit 1
			;;
		esac
	done
	dir="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/nshell-pick.XXXXXX")"
	trap 'rm -rf "$dir"' EXIT
	# the lines, and the pipe that the shell answers on: reading it waits until it does
	mkfifo "$dir/result"
	cat >"$dir/items"
	quickshell -p "$NSHELL_PATH" ipc call launcher pick "$dir" "$prompt" >/dev/null || exit 2
	answer="$(cat "$dir/result")"
	if [ "${answer%%$'\n'*}" = "OK" ]; then
		printf '%s\n' "${answer#*$'\n'}"
		exit 0
	fi
	exit 1
	;;
*)
	echo "usage: nshell [center [dnd] | bar | launcher [windows] | launch ID | tabs list | theme [dark|light|auto|toggle] | apps [dark|light] | pick [--prompt TEXT]]" >&2
	exit 1
	;;
esac
