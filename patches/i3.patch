+/* The container and all that is in it are not mapped: they are not in front, see render_con() */
+static void render_unmap(Con *con) {
+    Con *child;
+    con->mapped = false;
+    TAILQ_FOREACH (child, &(con->nodes_head), nodes) {
+        render_unmap(child);
+    }
+}
